{
    "name": "nails/module-phone",
    "keywords":
    [],
    "homepage": "http://nailsapp.co.uk/modules/phone",
    "description": "This module provides a unified API for formatting and validating phone numbers.",
    "license": "MIT",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require":
    {
        "php": ">=8.3",
        "ext-json": "*",
        "nails/common": "dev-develop"
    },
    "require-dev":
    {
        "phpunit/phpunit": "^12.0",
        "phpstan/phpstan": "^2.0"
    },
    "scripts":
    {
        "test": "./vendor/bin/phpunit",
        "analyse": "./vendor/bin/phpstan analyse -c .phpstan/config.neon"
    },
    "autoload":
    {
        "psr-4":
        {
            "Nails\\Phone\\": "src/"
        }
    },
    "autoload-dev":
    {
        "psr-4":
        {
            "Test\\Phone\\": "tests/"
        }
    },
    "extra":
    {
        "nails":
        {
            "moduleName": "phone",
            "type": "module",
            "namespace": "Nails\\Phone\\",
            "data":
            {}
        }
    }
}